[
  {
    "label": "iOS: Start Mac Signing Session",
    "command": "./scripts/mac-signing-session.sh",
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "iOS: Build + Install + Run",
    "command": "./scripts/linux-ios-run.sh",
    "args": ["run"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "iOS: Build + Install + Run + Logs",
    "command": "./scripts/linux-ios-run.sh",
    "args": ["logs"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "iOS: Install Existing IPA",
    "command": "./scripts/linux-ios-run.sh",
    "args": ["install-only"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "iOS: Mac Build IPA Only",
    "command": "./scripts/linux-ios-run.sh",
    "args": ["build-only"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "allow_concurrent_runs": false,
    "reveal": "always"
  }
]

